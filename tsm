#!/usr/bin/env ruby
# frozen_string_literal: true

# TSM - Tmux Session Manager
# Pure Ruby TUI, zero dependencies

VERSION = '1.9.5'
INSTALL_PATH = File.expand_path('~/.local/bin/tsm')
CONFIG_DIR = File.expand_path('~/.config/tsm')
CONFIG_FILE = File.join(CONFIG_DIR, 'config')
LAST_CHECK_FILE = File.join(CONFIG_DIR, 'last_check')
AVAILABLE_VERSION_FILE = File.join(CONFIG_DIR, 'available_version')
MACHINE_ID_FILE = File.join(CONFIG_DIR, 'machine-id')

UPDATE_URL_DEFAULT = 'https://raw.githubusercontent.com/dorra/tsm/main/tsm'
UPDATE_CHECK_INTERVAL = 86400 # 24 hours in seconds
SERVERS_FILE = File.join(CONFIG_DIR, 'servers')
SSH_TIMEOUT = 5
STORAGE_TIMEOUT = 5
STORAGE_BUCKET = 'tsm'
STORAGE_KEY = 'servers'

require 'securerandom'
require 'timeout'

# ─────────────────────────────────────────────────────────────
# Timeout helper (cross-platform, works on macOS without GNU coreutils)
# ─────────────────────────────────────────────────────────────

def run_with_timeout(cmd, timeout_secs)
  result = ""
  pid = nil

  begin
    Timeout.timeout(timeout_secs) do
      IO.popen(cmd, err: [:child, :out]) do |io|
        pid = io.pid
        result = io.read.to_s.force_encoding('UTF-8')
      end
    end
  rescue Timeout::Error
    # Kill the process tree if still running
    if pid
      Process.kill('TERM', -pid) rescue Process.kill('TERM', pid) rescue nil
      Process.wait(pid) rescue nil
    end
    result = ""
  end

  result
end

# ─────────────────────────────────────────────────────────────
# Machine ID (unique identifier per machine)
# ─────────────────────────────────────────────────────────────

module MachineId
  extend self

  def ensure!
    Dir.mkdir(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)
    return load if exists?
    generate!
  end

  def exists?
    File.exist?(MACHINE_ID_FILE)
  end

  def load
    return nil unless exists?
    File.read(MACHINE_ID_FILE).strip
  rescue
    nil
  end

  def generate!
    id = SecureRandom.uuid
    File.write(MACHINE_ID_FILE, id)
    id
  rescue
    nil
  end

  def current
    @current ||= load
  end

  def reset_cache!
    @current = nil
  end
end

# Server configuration struct
Server = Struct.new(:alias_name, :host, :user, :port, :machine_id, keyword_init: true) do
  def local?
    # Check machine_id first (primary method)
    if machine_id && !machine_id.empty?
      return machine_id == MachineId.current
    end
    # Fallback for legacy entries
    host.nil? || host.empty? || host == 'localhost'
  end

  def display_name
    alias_name
  end

  def ssh_target
    return nil if local?
    user && !user.empty? ? "#{user}@#{host}" : host
  end

  def to_line
    "#{alias_name}|#{host || ''}|#{user || ''}|#{port || 22}|#{machine_id || ''}"
  end
end

class TSM
  CLEAR = "\e[2J\e[H"
  RESET = "\e[0m"
  BOLD = "\e[1m"
  DIM = "\e[2m"
  GREEN = "\e[32m"
  YELLOW = "\e[33m"
  CYAN = "\e[36m"
  RED = "\e[31m"
  REVERSE = "\e[7m"

  def initialize
    @selected = 0
    @running = true
    @update_available = UpdateChecker.available_version
    @servers = ServerManager.load_servers
    @sessions = []
    @server_mode = false
    @server_selected = 0
    @fetch_errors = {}
    @server_results = {}
    @pending_threads = {}
  end

  def run
    check_tmux!

    # Ensure machine-id exists
    MachineId.ensure!
    MachineId.reset_cache!

    # Check if this machine has an entry in servers config
    ensure_self_entry!

    # Migrate old servers without machine-id
    migrate_server_machine_ids!

    # Trigger background update check if needed
    UpdateChecker.check_async

    # Start parallel fetch for all servers
    start_async_fetch

    # Pull shared config from storage (async)
    start_storage_pull

    loop do
      if @server_mode
        render_server_menu
        handle_server_input
      else
        check_storage_thread
        check_pending_threads
        @sessions = build_sessions
        render(@sessions)
        handle_input(@sessions)
      end
      break unless @running
    end
  end

  def start_async_fetch
    @fetch_errors = {}
    @server_results = {}
    @pending_threads = {}

    @servers.each do |server|
      @pending_threads[server.alias_name] = Thread.new do
        RemoteExecutor.fetch_sessions(server)
      end
    end
  end

  def check_pending_threads
    @pending_threads.each do |alias_name, thread|
      next unless thread.alive? == false
      begin
        result = thread.value
        if result[:error]
          @fetch_errors[alias_name] = result[:error]
        else
          @server_results[alias_name] = result[:sessions]
        end
      rescue => e
        @fetch_errors[alias_name] = e.message
      end
      @pending_threads.delete(alias_name)
    end
  end

  def start_storage_pull
    return unless StorageSync.configured?
    @storage_thread = Thread.new { StorageSync.pull }
  end

  def check_storage_thread
    return unless @storage_thread
    return if @storage_thread.alive?

    result, content = begin
      @storage_thread.value
    rescue
      [:error]
    end
    @storage_thread = nil

    case result
    when :ok then apply_pulled_config(content)
    when :not_found then push_servers_async # first machine: seed central copy
    end
  end

  def apply_pulled_config(content)
    current = File.exist?(SERVERS_FILE) ? File.read(SERVERS_FILE) : ''
    return if content == current

    self_entry = ServerManager.self_entry(@servers)
    Dir.mkdir(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)
    File.write(SERVERS_FILE, content)
    @servers = ServerManager.load_servers

    # Central list doesn't know this machine yet - re-add and share
    if self_entry && !ServerManager.self_entry(@servers)
      @servers << self_entry
      ServerManager.save_servers(@servers)
      push_servers_async
    end

    @selected = 0
    start_async_fetch
  end

  def push_servers_async
    return unless StorageSync.configured?
    content = File.read(SERVERS_FILE) rescue nil
    return unless content
    Thread.new { StorageSync.push(content) }
  end

  def build_sessions
    all_sessions = []

    @servers.each do |server|
      alias_name = server.alias_name

      if @pending_threads[alias_name]
        # Still loading - add loading placeholder
        all_sessions << { name: nil, server: server, loading: true }
      elsif @fetch_errors[alias_name]
        # Error - skip (shown in render)
        next
      else
        sessions = @server_results[alias_name] || []
        if sessions.empty?
          all_sessions << { name: nil, server: server, placeholder: true }
        else
          all_sessions.concat(sessions)
        end
      end
    end

    all_sessions
  end

  private

  def check_tmux!
    unless system('which tmux > /dev/null 2>&1')
      puts "#{RED}Error: tmux nicht gefunden#{RESET}"
      exit 1
    end
  end

  def ensure_self_entry!
    @servers = ServerManager.load_servers

    # Remove duplicate aliases (keep ones with machine_id)
    original_count = @servers.length
    ServerManager.remove_duplicates!(@servers)
    if @servers.length != original_count
      ServerManager.save_servers(@servers)
    end

    # Check if we have an entry with our machine_id
    self_server = ServerManager.self_entry(@servers)
    return if self_server

    # Check if there are entries without machine_id that we could claim
    unclaimed = @servers.select { |s| s.machine_id.nil? || s.machine_id.empty? }
    unclaimed.reject! { |s| s.host.nil? || s.host.empty? }  # Exclude legacy local

    if unclaimed.any?
      # Let user claim an existing entry
      claimed = claim_existing_entry(unclaimed)
      return if claimed
    end

    # No entry for this machine - prompt user to create one
    print CLEAR
    puts "  #{BOLD}#{CYAN}TSM Setup#{RESET}\n\n"
    puts "  #{DIM}Diese Maschine ist noch nicht in der Server-Config registriert.#{RESET}\n"
    puts "  #{DIM}Machine-ID: #{MachineId.current}#{RESET}\n\n"

    system('stty -raw echo')

    print "  Alias für diesen Rechner: "
    alias_name = $stdin.gets&.strip
    return if alias_name.nil? || alias_name.empty?

    # Check for duplicate alias
    if @servers.any? { |s| s.alias_name == alias_name }
      puts "\n  #{RED}Alias '#{alias_name}' existiert bereits!#{RESET}"
      sleep 2
      return
    end

    print "  Host/Domain (für SSH von anderen Rechnern): "
    host = $stdin.gets&.strip
    return if host.nil? || host.empty?

    print "  User (optional): "
    user = $stdin.gets&.strip
    user = nil if user&.empty?

    print "  Port (default 22): "
    port_str = $stdin.gets&.strip
    port = port_str&.empty? ? 22 : port_str.to_i

    new_server = Server.new(
      alias_name: alias_name,
      host: host,
      user: user,
      port: port,
      machine_id: MachineId.current
    )
    @servers << new_server

    # Remove legacy local entry if exists
    ServerManager.cleanup_legacy_local!(@servers)

    ServerManager.save_servers(@servers)

    puts "\n  #{GREEN}✓ Rechner '#{alias_name}' registriert#{RESET}\n"
    sleep 1
  end

  def claim_existing_entry(unclaimed)
    print CLEAR
    puts "  #{BOLD}#{CYAN}TSM Setup#{RESET}\n\n"
    puts "  #{DIM}Diese Maschine hat noch keine Machine-ID in der Config.#{RESET}\n"
    puts "  #{DIM}Machine-ID: #{MachineId.current}#{RESET}\n\n"
    puts "  #{BOLD}Bist du einer dieser Server?#{RESET}\n\n"

    unclaimed.each_with_index do |server, idx|
      puts "  #{CYAN}#{idx + 1}#{RESET}) #{server.alias_name} (#{server.host})"
    end
    puts "  #{CYAN}n#{RESET}) Nein, neuen Eintrag erstellen\n\n"

    print "  Auswahl: "
    system('stty -raw echo')
    choice = $stdin.gets&.strip&.downcase

    return false if choice == 'n' || choice.nil? || choice.empty?

    idx = choice.to_i - 1
    return false if idx < 0 || idx >= unclaimed.length

    # Claim this entry
    server = unclaimed[idx]
    server.machine_id = MachineId.current

    # Remove legacy local entry if exists
    ServerManager.cleanup_legacy_local!(@servers)

    ServerManager.save_servers(@servers)

    puts "\n  #{GREEN}✓ Machine-ID für '#{server.alias_name}' gesetzt#{RESET}\n"
    sleep 1
    true
  end

  def migrate_server_machine_ids!
    # Find servers without machine_id (excluding legacy local entries)
    servers_to_migrate = @servers.select do |s|
      s.machine_id.nil? && s.host && !s.host.empty? && s.host != 'localhost'
    end

    return if servers_to_migrate.empty?

    print CLEAR
    puts "  #{BOLD}#{CYAN}Migrating Server IDs#{RESET}\n\n"
    puts "  #{DIM}Fetching machine-ids from servers without ID...#{RESET}\n\n"

    changed = false
    servers_to_migrate.each do |server|
      remote_id = fetch_remote_machine_id(server)
      if remote_id
        server.machine_id = remote_id
        changed = true
      end
    end

    if changed
      ServerManager.save_servers(@servers)
      puts "\n  #{GREEN}✓ Server IDs migrated#{RESET}\n"
      sleep 1
    end
  end

  def render(sessions)
    print CLEAR
    puts

    # Header - clean and minimal
    print "  #{BOLD}tsm#{RESET} #{DIM}·#{RESET} "
    if @servers.length > 1
      print "#{CYAN}[#{@servers.length} servers]#{RESET} "
    end
    if @update_available && @update_available != VERSION
      puts "#{YELLOW}v#{@update_available} available#{RESET} #{DIM}(u to update)#{RESET}"
    else
      puts "#{DIM}v#{VERSION}#{RESET}"
    end
    puts

    render_grouped_sessions(sessions)

    puts
    render_help
  end

  def render_grouped_sessions(sessions)
    current_idx = 0

    @servers.each do |server|
      # Server header
      label = server.display_name
      puts "  #{BOLD}#{CYAN}#{label}#{RESET}"

      if @fetch_errors[server.alias_name]
        puts "    #{RED}⚠ #{@fetch_errors[server.alias_name]}#{RESET}"
        puts
        next
      end

      server_sessions = sessions.select { |s| s[:server]&.alias_name == server.alias_name }

      server_sessions.each do |session|
        if session[:loading]
          # Still fetching from server
          puts "      #{DIM}loading...#{RESET}"
          current_idx += 1
        elsif session[:placeholder]
          # Render selectable placeholder for empty server
          pointer = current_idx == @selected ? "#{CYAN}❯#{RESET}" : " "
          puts "  #{pointer}   #{DIM}(no sessions - press n to create)#{RESET}"
          current_idx += 1
        else
          render_session(session, current_idx == @selected)
          current_idx += 1
        end
      end
      puts
    end
  end

  def render_session(session, selected)
    now = Time.now.to_i
    age = format_age(now - session[:activity])

    # Selection indicator
    pointer = selected ? "#{CYAN}❯#{RESET}" : " "

    # Status indicator
    if session[:status] == 'attached'
      status = "#{GREEN}●#{RESET}"
    else
      status = "#{DIM}○#{RESET}"
    end

    # Session name - pad first, then apply formatting (ANSI codes don't count for width)
    name_padded = session[:name].ljust(22)
    name_display = selected ? "#{BOLD}#{name_padded}#{RESET}" : name_padded

    # Age - right aligned
    age_str = age.rjust(5)

    puts "  #{pointer} #{status} #{name_display} #{DIM}#{age_str}#{RESET}"
  end

  def format_age(seconds)
    case seconds
    when 0..59 then "now"
    when 60..3599 then "#{seconds / 60}m"
    when 3600..86399 then "#{seconds / 3600}h"
    else "#{seconds / 86400}d"
    end
  end

  def render_help
    help_parts = [
      "#{BOLD}↑↓#{RESET} #{DIM}nav#{RESET}",
      "#{CYAN}a#{RESET}#{DIM}ttach#{RESET}",
      "#{CYAN}n#{RESET}#{DIM}ew#{RESET}",
      "#{CYAN}d#{RESET}#{DIM}etach#{RESET}",
      "#{BOLD}⌫#{RESET} #{DIM}del#{RESET}",
      "#{CYAN}c#{RESET}#{DIM}onfig#{RESET}",
      "#{CYAN}q#{RESET}#{DIM}uit#{RESET}"
    ]

    if @update_available && @update_available != VERSION
      help_parts.insert(-2, "#{CYAN}u#{RESET}#{DIM}pdate#{RESET}")
    end

    puts "  #{help_parts.join('  ')}"
  end

  def handle_input(sessions)
    # Use timeout if still loading, so UI can refresh
    timeout = (@pending_threads.any? || @storage_thread) ? 0.3 : nil
    char = read_char(timeout)

    return unless char  # No input, just refresh

    case char
    when 'j', "\e[B"
      @selected = [@selected + 1, sessions.length - 1].min if sessions.any?
    when 'k', "\e[A"
      @selected = [@selected - 1, 0].max if sessions.any?
    when 'a', "\r", "\n"
      session = sessions[@selected]
      attach_session(session) if session && !session[:placeholder] && !session[:loading]
    when 'n'
      create_session(sessions)
    when 'd'
      session = sessions[@selected]
      detach_session(session) if session && !session[:placeholder] && !session[:loading]
    when "\x7f", "\b" # Backspace
      session = sessions[@selected]
      delete_session(session) if session && !session[:placeholder] && !session[:loading]
    when 'c'
      @server_mode = true
      @server_selected = 0
    when 'u'
      run_update if @update_available && @update_available != VERSION
    when 'q', "\e", "\u0003"
      @running = false
      print CLEAR
    end
  end

  def read_char(timeout = nil)
    system('stty raw -echo')

    if timeout
      # Non-blocking read with timeout
      ready = IO.select([$stdin], nil, nil, timeout)
      return nil unless ready
    end

    char = $stdin.getc
    if char == "\e"
      char += $stdin.read_nonblock(2) rescue ''
    end
    char
  ensure
    system('stty -raw echo')
  end

  def attach_session(session)
    return unless session

    server = session[:server]
    if server && !server.local?
      RemoteExecutor.attach_session(server, session[:name])
    else
      print CLEAR
      if ENV['TMUX']
        exec("tmux switch-client -t '#{session[:name]}'")
      else
        exec("tmux attach -t '#{session[:name]}'")
      end
    end
  end

  def create_session(sessions)
    # Don't create if selected item is still loading
    return if sessions.any? && sessions[@selected][:loading]

    # Determine target server from current selection
    server = if sessions.any?
      sessions[@selected][:server]
    else
      @servers.first
    end

    server_info = server && !server.local? ? " on #{CYAN}#{server.alias_name}#{RESET}" : ""

    print CLEAR
    print "#{BOLD}Neue Session#{server_info}: #{RESET}"
    system('stty -raw echo')
    name = $stdin.gets&.strip

    return if name.nil? || name.empty?

    RemoteExecutor.create_session(server, name)
  end

  def delete_session(session)
    return unless session

    server = session[:server]
    server_info = server && !server.local? ? " on #{server.alias_name}" : ""

    print CLEAR
    puts "#{RED}#{BOLD}Session '#{session[:name]}'#{server_info} wirklich löschen?#{RESET}\n\n"
    puts "  #{DIM}Diese Aktion kann nicht rückgängig gemacht werden.#{RESET}\n\n"
    print "  #{CYAN}y#{RESET}/#{DIM}n#{RESET}: "

    char = read_char

    if char.downcase == 'y' || char == "\r" || char == "\n"
      if server && !server.local?
        RemoteExecutor.kill_session(server, session[:name])
      else
        system("tmux kill-session -t '#{session[:name]}'")
      end
      @selected = [@selected - 1, 0].max
      start_async_fetch  # Refresh session list
    end
  end

  def detach_session(session)
    return unless session
    return unless session[:status] == 'attached'

    server = session[:server]
    server_info = server && !server.local? ? " on #{server.alias_name}" : ""

    print CLEAR
    puts "#{YELLOW}#{BOLD}Clients von '#{session[:name]}'#{server_info} trennen?#{RESET}\n\n"
    puts "  #{DIM}Alle verbundenen Clients werden getrennt.#{RESET}\n\n"
    print "  #{CYAN}y#{RESET}/#{DIM}n#{RESET}: "

    char = read_char

    if char.downcase == 'y' || char == "\r" || char == "\n"
      if server && !server.local?
        RemoteExecutor.detach_session(server, session[:name])
      else
        system("tmux detach-client -s '#{session[:name]}'")
      end
      start_async_fetch  # Refresh session list
    end
  end

  def run_update
    print CLEAR
    Installer.update!
    exit 0
  end

  # ─────────────────────────────────────────────────────────────
  # Server Management UI
  # ─────────────────────────────────────────────────────────────

  def render_server_menu
    print CLEAR
    puts
    puts "  #{BOLD}tsm#{RESET} #{DIM}·#{RESET} Server Management"
    puts

    @servers.each_with_index do |server, idx|
      pointer = idx == @server_selected ? "#{CYAN}❯#{RESET}" : " "

      if server.local?
        target = server.host || "localhost"
      else
        target = server.ssh_target || server.host
        target += ":#{server.port}" if server.port && server.port != 22
      end

      name_padded = server.alias_name.ljust(18)

      puts "  #{pointer} #{name_padded}  #{DIM}#{target}#{RESET}"
    end

    puts
    puts "  #{DIM}sync: #{StorageSync.status_line}#{RESET}"

    puts
    help_parts = [
      "#{BOLD}↑↓#{RESET} #{DIM}nav#{RESET}",
      "#{CYAN}a#{RESET}#{DIM}dd#{RESET}",
      "#{BOLD}⌫#{RESET} #{DIM}del#{RESET}",
      "#{CYAN}b#{RESET}#{DIM}ack#{RESET}"
    ]
    puts "  #{help_parts.join('  ')}"
  end

  def handle_server_input
    char = read_char

    case char
    when 'j', "\e[B"
      @server_selected = [@server_selected + 1, @servers.length - 1].min
    when 'k', "\e[A"
      @server_selected = [@server_selected - 1, 0].max
    when 'a'
      add_server_dialog
    when "\x7f", "\b" # Backspace
      delete_server_dialog
    when 'b', 'q', "\e", "\u0003"
      @server_mode = false
      @selected = 0
      start_async_fetch  # Refresh sessions
    end
  end

  def add_server_dialog
    print CLEAR
    puts "  #{BOLD}Add Server#{RESET}\n\n"

    system('stty -raw echo')

    print "  Alias: "
    alias_name = $stdin.gets&.strip
    return if alias_name.nil? || alias_name.empty?

    print "  Host:  "
    host = $stdin.gets&.strip
    return if host.nil? || host.empty?

    print "  User (optional): "
    user = $stdin.gets&.strip
    user = nil if user&.empty?

    print "  Port (default 22): "
    port_str = $stdin.gets&.strip
    port = port_str&.empty? ? 22 : port_str.to_i

    new_server = Server.new(
      alias_name: alias_name,
      host: host,
      user: user,
      port: port,
      machine_id: nil
    )

    # Ensure tsm is installed on new server and get machine-id
    ensure_tsm_on_server(new_server)
    remote_id = fetch_remote_machine_id(new_server)
    new_server.machine_id = remote_id if remote_id

    @servers << new_server
    ServerManager.save_servers(@servers)
    push_servers_async

    # Hand storage credentials to the new install so it can sync
    push_storage_config_to_server(new_server)
  end

  def delete_server_dialog
    return if @servers.length <= 1

    server = @servers[@server_selected]
    return if server.local? && @servers.count(&:local?) == 1

    print CLEAR
    puts "  #{RED}#{BOLD}Server '#{server.alias_name}' entfernen?#{RESET}\n\n"
    print "  #{CYAN}y#{RESET}/#{DIM}n#{RESET}: "

    if read_char.downcase == 'y'
      @servers.delete_at(@server_selected)
      @server_selected = [@server_selected - 1, 0].max
      ServerManager.save_servers(@servers)
      push_servers_async
    end
  end

  # Copy storage credentials so the new install can sync itself.
  # Only touches storage_url/storage_token; other config keys survive.
  def push_storage_config_to_server(server)
    return if server.local?

    cfg = StorageSync.config
    return unless cfg[:url] && cfg[:token]

    remote_cmd =
      'mkdir -p ~/.config/tsm && touch ~/.config/tsm/config && ' \
      'grep -v -e ^storage_url= -e ^storage_token= ~/.config/tsm/config > ~/.config/tsm/config.tmp; ' \
      "echo \"storage_url=#{cfg[:url]}\" >> ~/.config/tsm/config.tmp && " \
      "echo \"storage_token=#{cfg[:token]}\" >> ~/.config/tsm/config.tmp && " \
      'mv ~/.config/tsm/config.tmp ~/.config/tsm/config'

    print CLEAR
    puts "  #{DIM}Pushing storage credentials to #{server.alias_name}...#{RESET}"

    if system(RemoteExecutor.build_ssh_command(server, remote_cmd))
      puts "\n  #{GREEN}Credentials pushed to #{server.alias_name}#{RESET}\n"
    else
      puts "\n  #{RED}Credential push failed#{RESET}\n"
    end

    sleep 1
  end

  def ensure_tsm_on_server(server)
    return if server.local?

    # Check if tsm is installed AND machine-id exists
    check_cmd = RemoteExecutor.build_ssh_command(server,
      "test -f ~/.local/bin/tsm && test -s ~/.config/tsm/machine-id && echo ready")
    result = `#{check_cmd} 2>/dev/null`.strip

    if result == "ready"
      return  # Already installed with machine-id
    end

    print CLEAR
    puts "  #{DIM}Installing tsm on #{server.alias_name}...#{RESET}"

    # Download tsm to remote server
    download_cmd = RemoteExecutor.build_ssh_command(server,
      "mkdir -p ~/.local/bin && curl -fsSL #{UPDATE_URL_DEFAULT} -o ~/.local/bin/tsm && chmod +x ~/.local/bin/tsm")

    unless system(download_cmd)
      puts "  #{YELLOW}tsm download failed#{RESET}"
      sleep 1
      return
    end

    puts "  #{GREEN}tsm downloaded#{RESET}"

    # Run --install on remote to set up config dir and machine-id
    puts "  #{DIM}Running tsm --install on #{server.alias_name}...#{RESET}"
    install_cmd = RemoteExecutor.build_ssh_command(server, "~/.local/bin/tsm --install")

    if system(install_cmd)
      puts "  #{GREEN}tsm installed on #{server.alias_name}#{RESET}"
    else
      puts "  #{YELLOW}tsm --install failed, trying manual machine-id creation...#{RESET}"
      ensure_remote_machine_id(server)
    end

    sleep 1
  end

  def ensure_remote_machine_id(server)
    return if server.local?

    puts "  #{DIM}Creating machine-id on #{server.alias_name}...#{RESET}"

    # Create config dir and generate machine-id if not exists
    # Use double quotes for ruby -e to avoid shell escaping issues with SSH single quotes
    cmd = RemoteExecutor.build_ssh_command(server,
      'mkdir -p ~/.config/tsm && ' \
      'test -s ~/.config/tsm/machine-id || ' \
      'ruby -r securerandom -e "puts SecureRandom.uuid" > ~/.config/tsm/machine-id')

    system(cmd)
  end

  def fetch_remote_machine_id(server)
    return nil if server.local?

    puts "  #{DIM}Fetching machine-id from #{server.alias_name}...#{RESET}"

    # Try to read existing machine-id
    read_cmd = RemoteExecutor.build_ssh_command(server, "cat ~/.config/tsm/machine-id 2>/dev/null")
    result = `#{read_cmd}`.strip

    if $?.success? && !result.empty? && result =~ /^[0-9a-f-]{36}$/i
      puts "  #{GREEN}Machine-ID: #{result[0..7]}...#{RESET}"
      return result
    end

    # No machine-id exists, try to create one
    puts "  #{DIM}Creating machine-id on #{server.alias_name}...#{RESET}"

    create_cmd = RemoteExecutor.build_ssh_command(server,
      'mkdir -p ~/.config/tsm && ruby -r securerandom -e "puts SecureRandom.uuid" > ~/.config/tsm/machine-id && cat ~/.config/tsm/machine-id')
    result = `#{create_cmd}`.strip

    if $?.success? && !result.empty? && result =~ /^[0-9a-f-]{36}$/i
      puts "  #{GREEN}Machine-ID created: #{result[0..7]}...#{RESET}"
      return result
    end

    puts "  #{YELLOW}Could not get machine-id#{RESET}"
    nil
  end

end

# ─────────────────────────────────────────────────────────────
# Server Manager (load/save server configuration)
# ─────────────────────────────────────────────────────────────

module ServerManager
  extend self

  DEFAULT_LOCAL = Server.new(
    alias_name: 'local',
    host: nil,
    user: nil,
    port: 22,
    machine_id: nil
  )

  def load_servers
    return [DEFAULT_LOCAL.dup] unless File.exist?(SERVERS_FILE)

    servers = []
    File.readlines(SERVERS_FILE).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')

      parts = line.split('|')
      next if parts.length < 2

      # Legacy 6-column format: alias|host|user|port|is_main|machine_id.
      # New 5-column format has machine_id at index 4. is_main was always
      # literally 'true'/'false'; machine_ids are UUIDs, so no collision.
      machine_id = if parts[4] == 'true' || parts[4] == 'false'
        parts[5]
      else
        parts[4]
      end

      servers << Server.new(
        alias_name: parts[0],
        host: parts[1]&.empty? ? nil : parts[1],
        user: parts[2]&.empty? ? nil : parts[2],
        port: (parts[3] || 22).to_i,
        machine_id: machine_id&.empty? ? nil : machine_id
      )
    end

    servers.empty? ? [DEFAULT_LOCAL.dup] : servers
  rescue
    [DEFAULT_LOCAL.dup]
  end

  def save_servers(servers)
    Dir.mkdir(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)

    content = "# TSM Server Configuration\n"
    content += "# Format: alias|host|user|port|machine_id\n\n"

    servers.each do |s|
      content += "#{s.to_line}\n"
    end

    File.write(SERVERS_FILE, content)
  rescue
    # Silently fail
  end

  # Check if current machine has an entry with its machine_id
  def self_entry(servers)
    current_id = MachineId.current
    return nil unless current_id
    servers.find { |s| s.machine_id == current_id }
  end

  # Remove legacy local entries (host=nil) if a machine_id based entry exists
  def cleanup_legacy_local!(servers)
    has_self = servers.any? { |s| s.machine_id == MachineId.current }
    return servers unless has_self

    servers.reject! { |s| s.machine_id.nil? && (s.host.nil? || s.host.empty?) }
    servers
  end

  # Remove duplicate aliases, keeping the one with machine_id
  def remove_duplicates!(servers)
    seen = {}
    servers.reject! do |s|
      if seen[s.alias_name]
        # Duplicate found - keep the one with machine_id
        if s.machine_id && !s.machine_id.empty?
          # This one has machine_id, remove the previous one
          servers.delete(seen[s.alias_name])
          seen[s.alias_name] = s
          false
        else
          # This one has no machine_id, remove it
          true
        end
      else
        seen[s.alias_name] = s
        false
      end
    end
    servers
  end

  def find_by_alias(alias_name)
    load_servers.find { |s| s.alias_name == alias_name }
  end
end

# ─────────────────────────────────────────────────────────────
# Remote Executor (SSH commands for remote tmux)
# ─────────────────────────────────────────────────────────────

module RemoteExecutor
  extend self

  def fetch_sessions(server)
    if server.local?
      fetch_local_sessions(server)
    else
      fetch_remote_sessions(server)
    end
  end

  def build_ssh_command(server, remote_cmd)
    opts = "-o ConnectTimeout=#{SSH_TIMEOUT} -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
    port_opt = server.port && server.port != 22 ? "-p #{server.port}" : ""
    target = server.ssh_target

    # Add common paths to ensure tmux is found (Homebrew, local bin)
    path_prefix = "export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH; "
    "ssh #{opts} #{port_opt} #{target} '#{path_prefix}#{remote_cmd}'"
  end

  def attach_session(server, session_name)
    if server.local?
      local_attach(session_name)
    else
      remote_attach(server, session_name)
    end
  end

  def detach_session(server, session_name)
    if server.local?
      system("tmux detach-client -s '#{session_name}'")
    else
      cmd = build_ssh_command(server, "tmux detach-client -s '#{session_name}'")
      system(cmd)
    end
  end

  def kill_session(server, session_name)
    if server.local?
      system("tmux kill-session -t '#{session_name}'")
    else
      cmd = build_ssh_command(server, "tmux kill-session -t '#{session_name}'")
      system(cmd)
    end
  end

  def create_session(server, session_name)
    if server.local?
      if ENV['TMUX']
        system("tmux new-session -d -s '#{session_name}' && tmux switch-client -t '#{session_name}'")
      else
        exec("tmux new-session -s '#{session_name}'")
      end
    else
      # Create remote session and attach via SSH
      create_cmd = "tmux new-session -d -s '#{session_name}'"
      cmd = build_ssh_command(server, create_cmd)
      if system(cmd)
        remote_attach(server, session_name)
      end
    end
  end

  def list_sessions(server)
    result = fetch_sessions(server)

    if result[:error]
      puts "Error: #{result[:error]}"
      return
    end

    if result[:sessions].empty?
      puts "No sessions"
      return
    end

    now = Time.now.to_i
    result[:sessions].each do |s|
      status = s[:status] == 'attached' ? '●' : '○'
      age = format_age(now - s[:activity])
      puts "#{status} #{s[:name].ljust(20)} #{age.rjust(5)}"
    end
  end

  def attach_or_create(server, session_name)
    result = fetch_sessions(server)
    session_exists = result[:sessions]&.any? { |s| s[:name] == session_name }

    if session_exists
      attach_session(server, session_name)
    else
      create_session(server, session_name)
    end
  end

  private

  def format_age(seconds)
    case seconds
    when 0..59 then "now"
    when 60..3599 then "#{seconds / 60}m"
    when 3600..86399 then "#{seconds / 3600}h"
    else "#{seconds / 86400}d"
    end
  end

  def fetch_local_sessions(server)
    format = '#{session_name}|#{session_windows}|#{?session_attached,attached,detached}|#{session_activity}'
    output = `tmux list-sessions -F '#{format}' 2>/dev/null`

    sessions = output.lines.map do |line|
      name, windows, status, activity = line.strip.split('|')
      {
        name: name,
        windows: windows.to_i,
        status: status,
        activity: activity.to_i,
        server: server
      }
    end

    { error: nil, sessions: sessions.sort_by { |s| -s[:activity] } }
  rescue => e
    { error: e.message, sessions: [] }
  end

  def fetch_remote_sessions(server)
    # First check if SSH connection works (with retry)
    test_cmd = build_ssh_command(server, "echo ok")
    test_output = nil
    2.times do |attempt|
      test_output = run_with_timeout("#{test_cmd} 2>/dev/null", SSH_TIMEOUT)
      break if !test_output.empty? && test_output.strip == "ok"
      sleep 1 if attempt == 0
    end

    unless test_output&.strip == "ok"
      return { error: "Connection failed", sessions: [] }
    end

    # Now fetch sessions (use %q[] to prevent Ruby interpolation, double quotes for shell)
    format = %q[#{session_name}|#{session_windows}|#{?session_attached,attached,detached}|#{session_activity}]
    cmd = build_ssh_command(server, 'tmux list-sessions -F "' + format + '" 2>/dev/null || true')

    output = run_with_timeout("#{cmd} 2>/dev/null", SSH_TIMEOUT)

    sessions = output.lines.map do |line|
      parts = line.strip.split('|')
      next if parts.length < 4

      {
        name: parts[0],
        windows: parts[1].to_i,
        status: parts[2],
        activity: parts[3].to_i,
        server: server
      }
    end.compact

    { error: nil, sessions: sessions.sort_by { |s| -s[:activity] } }
  rescue => e
    { error: e.message, sessions: [] }
  end

  def local_attach(session_name)
    print "\e[2J\e[H"
    if ENV['TMUX']
      exec("tmux switch-client -t '#{session_name}'")
    else
      exec("tmux attach -t '#{session_name}'")
    end
  end

  def remote_attach(server, session_name)
    print "\e[2J\e[H"
    opts = "-o StrictHostKeyChecking=accept-new"
    port_opt = server.port && server.port != 22 ? "-p #{server.port}" : ""
    target = server.ssh_target
    path_prefix = "export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH; "

    exec("ssh #{opts} #{port_opt} -t #{target} '#{path_prefix}tmux attach -t \"#{session_name}\"'")
  end
end

# ─────────────────────────────────────────────────────────────
# Update Checker (background, max once per day)
# ─────────────────────────────────────────────────────────────

module UpdateChecker
  extend self

  def should_check?
    return false unless File.exist?(INSTALL_PATH) # Only check if installed

    # Ensure config dir exists
    Dir.mkdir(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)

    return true unless File.exist?(LAST_CHECK_FILE)

    last_check = File.read(LAST_CHECK_FILE).to_i
    Time.now.to_i - last_check > UPDATE_CHECK_INTERVAL
  rescue
    false
  end

  def available_version
    return nil unless File.exist?(AVAILABLE_VERSION_FILE)

    version = File.read(AVAILABLE_VERSION_FILE).strip
    version.empty? ? nil : version
  rescue
    nil
  end

  def check_async
    return unless should_check?

    # Fork to check in background (non-blocking)
    pid = Process.fork do
      check_now
    end
    Process.detach(pid) if pid
  rescue
    # Fork failed or not available, try thread
    Thread.new { check_now } rescue nil
  end

  def check_now
    url = load_update_url rescue nil
    return if url.nil? || url.include?('OWNER')

    content = fetch_url_quick(url)
    return unless content

    if match = content.match(/VERSION = '([^']+)'/)
      remote_version = match[1]
      File.write(AVAILABLE_VERSION_FILE, remote_version) rescue nil
    end

    File.write(LAST_CHECK_FILE, Time.now.to_i.to_s) rescue nil
  rescue
    # Silently fail - don't disrupt user
  end

  def fetch_url_quick(url)
    # Quick fetch with short timeout for background check
    if system('which curl > /dev/null 2>&1')
      result = `curl -fsSL --connect-timeout 3 --max-time 5 '#{url}' 2>/dev/null`
      return result if $?.success? && !result.empty?
    end

    require 'net/http'
    require 'uri'

    uri = URI.parse(url)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == 'https'
    http.open_timeout = 3
    http.read_timeout = 5

    response = http.get(uri.request_uri)
    response.is_a?(Net::HTTPSuccess) ? response.body : nil
  rescue => e
    nil
  end

  def load_update_url
    if File.exist?(CONFIG_FILE)
      config = File.read(CONFIG_FILE)
      if match = config.match(/^update_url=(.+)$/)
        return match[1].strip
      end
    end
    UPDATE_URL_DEFAULT
  rescue
    UPDATE_URL_DEFAULT
  end
end

# ─────────────────────────────────────────────────────────────
# Storage Sync (config sync via storage-for-agents)
# ─────────────────────────────────────────────────────────────

module StorageSync
  extend self

  def configured?
    c = config
    !!(c[:url] && c[:token])
  end

  def config
    return @config if @config
    url = token = nil
    if File.exist?(CONFIG_FILE)
      content = File.read(CONFIG_FILE)
      url = content[/^storage_url=(.+)$/, 1]&.strip
      token = content[/^storage_token=(.+)$/, 1]&.strip
    end
    @config = { url: url, token: token }
  rescue
    @config = { url: nil, token: nil }
  end

  # Pull servers file. Returns [:ok, content], [:not_found] or [:error].
  def pull
    return [:error] unless configured?

    presigned = presign('get')
    return [:not_found] if presigned == :not_found
    return [:error] unless presigned

    status, body = transfer(:get, presigned)
    case status
    when 200 then mark_synced; [:ok, body]
    when 404 then [:not_found]
    else @state ||= :offline; [:error]
    end
  end

  # Push servers file. Returns true/false.
  def push(content)
    return false unless configured?

    presigned = presign('put')
    if presigned == :not_found
      return false unless ensure_bucket
      presigned = presign('put')
    end
    return false unless presigned && presigned != :not_found

    status, _body = transfer(:put, presigned, body: content)
    if status == 200
      mark_synced
      true
    else
      @state ||= :offline
      false
    end
  end

  def status_line
    return 'no storage configured' unless configured?
    case @state
    when :synced
      age = Time.now.to_i - @synced_at
      age < 60 ? 'synced now' : "synced #{age / 60}m ago"
    when :auth_failed then 'auth failed'
    when :offline then 'offline'
    else 'not synced yet'
    end
  end

  private

  def mark_synced
    @state = :synced
    @synced_at = Time.now.to_i
  end

  def ensure_bucket
    res = api_request(:put, "/api/buckets/#{STORAGE_BUCKET}")
    !res.nil? && [200, 201].include?(res.code.to_i)
  end

  # Returns presigned url (String), :not_found, or nil on error.
  def presign(op)
    require 'json'
    body = { op: op, key: STORAGE_KEY }
    body[:content_type] = 'text/plain' if op == 'put'
    res = api_request(:post, "/api/buckets/#{STORAGE_BUCKET}/objects/presign",
                      body: JSON.generate(body))
    return nil unless res

    case res.code.to_i
    when 200, 201
      url = JSON.parse(res.body)['url'] rescue nil
      return nil unless url
      url.start_with?('/') ? "#{config[:url]}#{url}" : url
    when 401, 403
      @state = :auth_failed
      nil
    when 404
      :not_found
    else
      @state ||= :offline
      nil
    end
  end

  def api_request(method, path, body: nil)
    require 'net/http'
    require 'uri'

    uri = URI.parse("#{config[:url]}#{path}")
    req = method == :put ? Net::HTTP::Put.new(uri.request_uri) : Net::HTTP::Post.new(uri.request_uri)
    req['Authorization'] = "Bearer #{config[:token]}"
    if body
      req['Content-Type'] = 'application/json'
      req.body = body
    end
    http_start(uri) { |http| http.request(req) }
  rescue
    @state = :offline
    nil
  end

  # Returns [status_code, body] or [nil, nil] on network error.
  def transfer(method, url, body: nil)
    require 'net/http'
    require 'uri'

    uri = URI.parse(url)
    req = if method == :put
      r = Net::HTTP::Put.new(uri.request_uri)
      r['Content-Type'] = 'text/plain'
      r.body = body
      r
    else
      Net::HTTP::Get.new(uri.request_uri)
    end
    res = http_start(uri) { |http| http.request(req) }
    [res.code.to_i, res.body]
  rescue
    @state = :offline
    [nil, nil]
  end

  def http_start(uri)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == 'https'
    http.open_timeout = STORAGE_TIMEOUT
    http.read_timeout = STORAGE_TIMEOUT
    yield http
  end
end

# ─────────────────────────────────────────────────────────────
# Installation & Update Logic
# ─────────────────────────────────────────────────────────────

module Installer
  extend self

  RESET = "\e[0m"
  BOLD = "\e[1m"
  DIM = "\e[2m"
  GREEN = "\e[32m"
  YELLOW = "\e[33m"
  CYAN = "\e[36m"
  RED = "\e[31m"

  def installed?
    File.exist?(INSTALL_PATH) && File.executable?(INSTALL_PATH)
  end

  def running_from_install_path?
    File.realpath($0) == File.realpath(INSTALL_PATH)
  rescue Errno::ENOENT
    false
  end

  def detect_shell
    shell = ENV['SHELL'] || ''

    # Check ENV['SHELL'] first
    if shell.include?('zsh')
      return { name: 'zsh', rc: File.expand_path('~/.zshrc') }
    elsif shell.include?('bash')
      bashrc = File.expand_path('~/.bashrc')
      bash_profile = File.expand_path('~/.bash_profile')
      rc = File.exist?(bashrc) ? bashrc : bash_profile
      return { name: 'bash', rc: rc }
    end

    # Fallback: check existing rc files (for non-interactive SSH sessions)
    zshrc = File.expand_path('~/.zshrc')
    bashrc = File.expand_path('~/.bashrc')
    bash_profile = File.expand_path('~/.bash_profile')

    if File.exist?(zshrc)
      { name: 'zsh', rc: zshrc }
    elsif File.exist?(bashrc)
      { name: 'bash', rc: bashrc }
    elsif File.exist?(bash_profile)
      { name: 'bash', rc: bash_profile }
    elsif RUBY_PLATFORM.include?('darwin')
      # macOS defaults to zsh
      { name: 'zsh', rc: zshrc }
    else
      # Linux defaults to bash
      { name: 'bash', rc: bashrc }
    end
  end

  def path_configured?(shell_info)
    return true unless shell_info
    return false unless File.exist?(shell_info[:rc])  # Create if not exists

    content = File.read(shell_info[:rc])
    content.include?('.local/bin')
  end

  def install!
    puts "#{BOLD}#{CYAN}TSM Installation#{RESET}\n\n"

    # Create directories
    install_dir = File.dirname(INSTALL_PATH)
    unless Dir.exist?(install_dir)
      puts "  #{DIM}Erstelle #{install_dir}...#{RESET}"
      Dir.mkdir(install_dir)
    end

    # Copy script
    puts "  #{DIM}Kopiere nach #{INSTALL_PATH}...#{RESET}"
    source = File.read($0)
    File.write(INSTALL_PATH, source)
    File.chmod(0755, INSTALL_PATH)

    # Configure shell
    shell_info = detect_shell
    if shell_info && !path_configured?(shell_info)
      puts "  #{DIM}Konfiguriere #{shell_info[:name]}...#{RESET}"
      configure_shell(shell_info)
    end

    # Create config directory
    unless Dir.exist?(CONFIG_DIR)
      Dir.mkdir(CONFIG_DIR)
    end

    # Generate machine-id
    puts "  #{DIM}Generiere Machine-ID...#{RESET}"
    MachineId.ensure!

    puts "\n#{GREEN}#{BOLD}✓ Installation erfolgreich!#{RESET}\n\n"

    if shell_info && !path_configured?(shell_info)
      puts "  #{YELLOW}Starte eine neue Shell oder führe aus:#{RESET}"
      puts "  #{BOLD}source #{shell_info[:rc]}#{RESET}\n\n"
    end

    puts "  Dann einfach: #{BOLD}tsm#{RESET}\n\n"
  end

  def configure_shell(shell_info)
    path_line = "\n# TSM - Tmux Session Manager\nexport PATH=\"$HOME/.local/bin:$PATH\"\n"

    File.open(shell_info[:rc], 'a') do |f|
      f.write(path_line)
    end
  end

  def update!(local_only: false)
    puts "#{BOLD}#{CYAN}TSM Update#{RESET}\n\n"

    url = load_update_url

    if url.include?('OWNER')
      puts "#{RED}Update-URL nicht konfiguriert!#{RESET}\n\n"
      puts "Bearbeite #{CONFIG_FILE} oder das Script selbst"
      puts "und setze die GitHub Raw URL.\n\n"
      puts "Beispiel:"
      puts "#{DIM}https://raw.githubusercontent.com/deinuser/tsm/main/tsm#{RESET}\n\n"
      exit 1
    end

    puts "  #{DIM}Lade von #{url}...#{RESET}"

    new_content = fetch_url(url)

    unless new_content
      puts "#{RED}Download fehlgeschlagen!#{RESET}"
      exit 1
    end

    # Force UTF-8 encoding to avoid issues on servers with different locales
    new_content.force_encoding('UTF-8')

    new_version = new_content.match(/VERSION = '([^']+)'/)&.[](1) || 'unknown'

    if new_version == VERSION
      puts "\n#{GREEN}Bereits aktuell (v#{VERSION})#{RESET}\n\n"
      # Clear available version cache
      File.delete(AVAILABLE_VERSION_FILE) if File.exist?(AVAILABLE_VERSION_FILE)
      # Update remote servers only if not local_only
      update_remote_servers! unless local_only
      exit 0
    end

    # Backup current
    backup_path = "#{INSTALL_PATH}.backup"
    if installed?
      puts "  #{DIM}Backup nach #{backup_path}...#{RESET}"
      File.write(backup_path, File.read(INSTALL_PATH))
    end

    # Write new version
    target = installed? ? INSTALL_PATH : $0
    puts "  #{DIM}Installiere v#{new_version}...#{RESET}"
    File.write(target, new_content)
    File.chmod(0755, target)

    # Clear available version cache
    File.delete(AVAILABLE_VERSION_FILE) if File.exist?(AVAILABLE_VERSION_FILE)

    puts "\n#{GREEN}#{BOLD}✓ Update erfolgreich!#{RESET}"
    puts "  #{DIM}v#{VERSION} → v#{new_version}#{RESET}\n\n"

    # Update on all remote servers only if not local_only
    update_remote_servers! unless local_only
  end

  def update_remote_servers!
    servers = ServerManager.load_servers.reject(&:local?)
    return if servers.empty?

    puts "#{BOLD}Remote Server Updates#{RESET}\n\n"

    servers.each do |server|
      print "  #{server.alias_name}... "

      begin
        # Check if tsm is installed (with timeout and retry)
        check_cmd = RemoteExecutor.build_ssh_command(server, "test -f ~/.local/bin/tsm && echo ok")
        result = nil
        2.times do |attempt|
          result = run_with_timeout("#{check_cmd} 2>&1", 10).strip
          break if result == "ok"
          sleep 1 if attempt == 0  # Wait before retry
        end

        unless result == "ok"
          if result.empty?
            puts "#{YELLOW}timeout#{RESET}"
          elsif result.downcase.include?("connection") || result.downcase.include?("ssh")
            puts "#{YELLOW}SSH fehlgeschlagen#{RESET}"
          else
            puts "#{YELLOW}tsm nicht installiert#{RESET}"
          end
          next
        end

        # Run update on remote (with timeout)
        update_cmd = RemoteExecutor.build_ssh_command(server, "~/.local/bin/tsm --update-local 2>&1")
        output = run_with_timeout("#{update_cmd} 2>&1", 60)
        status = !output.empty?

        if status
          # Extract version info from output
          if output.include?("Bereits aktuell")
            puts "#{GREEN}aktuell#{RESET}"
          elsif output.include?("Update erfolgreich")
            version_match = output.match(/v[\d.]+ → v([\d.]+)/)
            new_ver = version_match ? version_match[1] : "?"
            puts "#{GREEN}→ v#{new_ver}#{RESET}"
          else
            puts "#{GREEN}ok#{RESET}"
          end
        else
          puts "#{RED}fehlgeschlagen#{RESET}"
        end
      rescue => e
        puts "#{RED}Fehler: #{e.message[0..30]}#{RESET}"
      end
    end

    puts
  end

  def fetch_url(url)
    if system('which curl > /dev/null 2>&1')
      result = `curl -fsSL '#{url}' 2>/dev/null`
      return result if $?.success? && !result.empty?
    end

    require 'net/http'
    require 'uri'

    uri = URI.parse(url)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == 'https'
    http.open_timeout = 10
    http.read_timeout = 10

    response = http.get(uri.request_uri)
    response.is_a?(Net::HTTPSuccess) ? response.body : nil
  rescue => e
    nil
  end

  def load_update_url
    if File.exist?(CONFIG_FILE)
      config = File.read(CONFIG_FILE)
      if match = config.match(/^update_url=(.+)$/)
        return match[1].strip
      end
    end
    UPDATE_URL_DEFAULT
  rescue
    UPDATE_URL_DEFAULT
  end

  def prompt_install
    puts "#{BOLD}#{CYAN}TSM - Tmux Session Manager#{RESET}\n\n"
    puts "TSM ist noch nicht installiert.\n\n"
    print "Jetzt installieren? [#{BOLD}Y#{RESET}/n]: "

    answer = $stdin.gets&.strip&.downcase
    if answer.empty? || answer == 'y' || answer == 'j'
      puts
      install!
      true
    else
      puts "\n#{DIM}OK. Du kannst später installieren mit:#{RESET}"
      puts "#{BOLD}./tsm --install#{RESET}\n\n"
      false
    end
  end

  def show_version
    puts "tsm v#{VERSION}"
    if installed?
      puts "#{DIM}Installiert: #{INSTALL_PATH}#{RESET}"
    else
      puts "#{DIM}Nicht installiert#{RESET}"
    end

    available = UpdateChecker.available_version
    if available && available != VERSION
      puts "#{YELLOW}Update verfügbar: v#{available}#{RESET}"
    end
  end

  def show_help
    puts <<~HELP
      #{BOLD}TSM - Tmux Session Manager#{RESET} v#{VERSION}

      #{BOLD}Usage:#{RESET}
        tsm                      Start TUI
        tsm <server>             List sessions on server
        tsm <server> <session>   Attach or create session

      #{BOLD}Examples:#{RESET}
        tsm local                List local sessions
        tsm local dev            Attach/create local 'dev'
        tsm spacestation         List sessions on spacestation
        tsm spacestation api     Attach/create 'api' on spacestation

      #{BOLD}Options:#{RESET}
        --install, -i       Install to ~/.local/bin
        --update, -u        Update from GitHub
        --check, -c         Check for updates
        --version, -v       Show version
        --help, -h          Show this help

      #{BOLD}TUI Keys:#{RESET}
        j/k, ↑/↓    Navigate
        a/Enter     Attach session
        n           New session
        d           Detach session
        c           Server config
        q           Quit
    HELP
  end

  def check_update_manual
    puts "#{BOLD}Prüfe auf Updates...#{RESET}\n"
    UpdateChecker.check_now

    available = UpdateChecker.available_version
    if available && available != VERSION
      puts "#{GREEN}Update verfügbar: v#{VERSION} → v#{available}#{RESET}"
      puts "#{DIM}Installieren mit: tsm --update#{RESET}"
    else
      puts "#{GREEN}Bereits aktuell (v#{VERSION})#{RESET}"
    end
  end
end

# ─────────────────────────────────────────────────────────────
# Entry Point
# ─────────────────────────────────────────────────────────────

if __FILE__ == $0
  trap('INT') { print "\e[2J\e[H"; exit 0 }

  case ARGV[0]
  when '--install', '-i'
    Installer.install!
  when '--update', '-u'
    Installer.update!
  when '--update-local'
    Installer.update!(local_only: true)
  when '--check', '-c'
    Installer.check_update_manual
  when '--version', '-v'
    Installer.show_version
  when '--help', '-h'
    Installer.show_help
  when '--debug', '-d'
    # Debug SSH connections to all servers
    servers = ServerManager.load_servers
    puts "Machine-ID: #{MachineId.current}"
    puts "Servers: #{servers.length}\n\n"
    path_prefix = "export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH; "
    servers.each do |s|
      puts "#{s.alias_name}:"
      puts "  host: #{s.host.inspect}"
      puts "  machine_id: #{s.machine_id.inspect}"
      puts "  local?: #{s.local?}"
      next if s.local?

      puts "  Testing SSH..."
      cmd = "ssh -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
      cmd += " -p #{s.port}" if s.port && s.port != 22
      target = s.user && !s.user.empty? ? "#{s.user}@#{s.host}" : s.host

      test_result = run_with_timeout("#{cmd} #{target} '#{path_prefix}echo ok' 2>&1", 10).strip
      puts "  echo ok: #{test_result.inspect}"

      tmux_result = run_with_timeout("#{cmd} #{target} '#{path_prefix}tmux list-sessions 2>&1' 2>&1", 10).strip
      puts "  tmux list-sessions: #{tmux_result.inspect}"
      puts
    end
  when nil
    # No arguments - start TUI
    unless Installer.installed? || Installer.running_from_install_path?
      exit 0 unless Installer.prompt_install
    end
    TSM.new.run
  else
    # tsm <server> [session]
    arg = ARGV[0]
    if arg.start_with?('-')
      puts "Unknown option: #{arg}"
      puts "Run 'tsm --help' for usage"
      exit 1
    end

    server = ServerManager.find_by_alias(arg)
    unless server
      puts "Server '#{arg}' not found"
      puts "Available servers: #{ServerManager.load_servers.map(&:alias_name).join(', ')}"
      exit 1
    end

    if ARGV.length == 1
      # tsm local / tsm spacestation → list sessions
      RemoteExecutor.list_sessions(server)
    else
      # tsm local dev / tsm spacestation api → attach or create
      RemoteExecutor.attach_or_create(server, ARGV[1])
    end
  end
end
